# =============================================================================
# Outlier CS2 + NBA Research Dashboard — environment variables
# Copy this file to .env and fill in the values you need.
# Do NOT commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# CS2 — Provider selection
# ---------------------------------------------------------------------------
#
# Provider to use for CS2 data.
#   hltv  = gigobyte/hltv Node.js bridge (PRIMARY — current default)
#           Requires `npm install` inside services/cs2/hltv_bridge/
#   mock  = static demo data (no network, no credentials)
#   grid  = GRID Open Access (EXPERIMENTAL / future placeholder)
#           Only useful if your GRID account includes Central Data access.
#
# If CS2_PROVIDER=hltv and the bridge is missing, the app falls back to
# mock data.  GRID is only consulted when you explicitly select it.
CS2_PROVIDER=hltv

# Directory for the shared CS2 disk cache (JSON files, grid: and hltv: keys).
# Default: <workspace>/data/cs2_cache/
# CS2_CACHE_DIR=/path/to/cache/dir

# Force demo data even when a live provider is configured (development mode).
CS2_USE_MOCK_FALLBACK=false

# ---------------------------------------------------------------------------
# CS2 — HLTV (primary)
# ---------------------------------------------------------------------------
# HLTV is a web-scrape-based bridge.  It is unofficial and depends on
# HLTV's site not erecting Cloudflare challenges for your IP.  The
# anti-ban architecture (cache-first, serialised requests, throttling,
# circuit breaker, stale fallback) is designed to keep usage polite.
#
# Setup (one-time):
#   cd services/cs2/hltv_bridge
#   npm install
#   cd ../../..
#
# HLTV works most reliably from a home / residential IP.

# Min delay between consecutive HLTV outbound requests (seconds).
# Recommended range: 2–5 seconds. Increase if you see Cloudflare blocks.
CS2_HLTV_THROTTLE_SECONDS=3

# Max retries for a single HLTV call (0 = first attempt only).
# Keep at 1 to avoid retry storms that look like scraping.
CS2_HLTV_MAX_RETRIES=1

# Consecutive failures before the circuit breaker trips.
CS2_HLTV_CB_THRESHOLD=3

# Time window (seconds) for counting consecutive failures.
CS2_HLTV_CB_WINDOW_S=120

# How long to pause HLTV requests after the circuit breaker trips (seconds).
CS2_HLTV_COOLDOWN_SECONDS=300

# Timeout for the Node.js bridge subprocess (seconds).
CS2_HLTV_NODE_TIMEOUT=30

# ---------------------------------------------------------------------------
# CS2 — GRID Open Access (future placeholder, not active by default)
# ---------------------------------------------------------------------------
# GRID support is preserved in the codebase as a future option.  It is
# only invoked when CS2_PROVIDER=grid.  The free Open Access tier today
# does not include Central Data GraphQL access (needed for match lists,
# teams, players) — so this is experimental.
#
# Setup:
#   1. Register at https://www.grid.gg/
#   2. Navigate to Account Management > Users > API Keys
#   3. Create a new API key and paste it below.
#   4. Flip CS2_PROVIDER=grid to try it.
# GRID_API_KEY=your-grid-api-key-here

# GRID API base URL (change only if GRID updates their endpoint).
# GRID_BASE_URL=https://api.grid.gg

# CS2/CS:GO title ID on the GRID platform. Default: 4 (CS:GO / CS2).
# GRID_CS2_TITLE_ID=4

# Seconds between consecutive outbound GRID requests.
# GRID_THROTTLE_SECONDS=1

# Per-request HTTP timeout for GRID (seconds).
# GRID_TIMEOUT_SECONDS=15

# Max retries per GRID call (0 = first attempt only).
# GRID_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# CS2 — HLTV enrichment (legacy flag; only meaningful if CS2_PROVIDER=grid)
# ---------------------------------------------------------------------------
# When the primary provider is GRID, this adds HLTV data (ADR, ranking,
# name search) on top.  Ignored when CS2_PROVIDER=hltv (already primary).
# CS2_ENABLE_HLTV_ENRICHMENT=false

# ---------------------------------------------------------------------------
# CS2 — PandaScore (optional supplement, rarely needed)
# ---------------------------------------------------------------------------
# Provides a reliable schedule / fixture feed. Fully optional.
# Sign up free at https://pandascore.co to get a token.
# PANDASCORE_TOKEN=your_free_api_token_here

# ---------------------------------------------------------------------------
# NBA (existing — leave blank to use defaults)
# ---------------------------------------------------------------------------
# NBA_API_MIN_CALL_INTERVAL_S=0.35
